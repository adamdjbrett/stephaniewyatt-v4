{
  "name": "stephaniewyatt-net",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('_site',{recursive:true,force:true})\"",
    "dev": "npm run clean && buildawesome --serve --port=8080",
    "build": "npm run clean && buildawesome && pagefind --site _site --glob '**/*.html'",
    "check": "node --test scripts/check.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@awesome.me/buildawesome": "4.0.0-alpha.10",
    "pagefind": "1.5.2",
    "yaml": "2.9.0"
  }
}
