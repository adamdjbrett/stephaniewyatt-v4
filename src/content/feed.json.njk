---
permalink: /feed.json
eleventyExcludeFromCollections: true
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ metadata.title | json | safe }},
  "home_page_url": "{{ metadata.url }}/",
  "feed_url": "{{ metadata.url }}/feed.json",
  "description": {{ metadata.description | json | safe }},
  "language": "{{ metadata.language }}",
  "authors": [{ "name": "{{ metadata.author.name }}", "url": "{{ metadata.author.url }}" }],
  "items": [{% for post in collections.posts | reverse %}
    {
      "id": "{{ metadata.url }}{{ post.url }}",
      "url": "{{ metadata.url }}{{ post.url }}",
      "title": {{ post.data.title | striptags | json | safe }},
      "content_html": {{ post.templateContent | json | safe }},
      "date_published": "{{ post.date | isoDate }}"
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
