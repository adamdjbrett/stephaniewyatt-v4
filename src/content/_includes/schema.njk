<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{{ metadata.person | json | safe }},{{ metadata.website | json | safe }},{{ metadata.blog | json | safe }}{% for work in metadata.publications %},{{ work | json | safe }}{% endfor %}{% if contentType == "blogPost" %},{"@type":"BlogPosting","@id":{{ (metadata.url ~ page.url ~ "#blogposting") | json | safe }},"url":{{ (metadata.url ~ page.url) | json | safe }},"mainEntityOfPage":{{ (metadata.url ~ page.url) | json | safe }},"headline":{{ title | json | safe }}{% if description %},"description":{{ description | json | safe }}{% endif %},"datePublished":{{ date | isoDate | json | safe }}{% if last_modified_at %},"dateModified":{{ last_modified_at | isoDate | json | safe }}{% endif %},"author":{"@id":"https://stephaniewyatt.net/#person"},"publisher":{"@id":"https://stephaniewyatt.net/#person"},"isPartOf":{"@id":"https://stephaniewyatt.net/blog/#blog"},"inLanguage":"en-US","license":"https://creativecommons.org/licenses/by-sa/4.0/"{% if image %},"image":{{ (metadata.url ~ image) | json | safe }}{% endif %}{% if tags %},"keywords":{{ tags | json | safe }}{% endif %}}{% endif %}]}</script>
