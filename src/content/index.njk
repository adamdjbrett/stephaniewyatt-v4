---
layout: home.njk
eleventyComputed:
  title: "{{ index.title }}"
  description: "{{ index.description }}"
permalink: /
---
{% macro textLink(link, light = false) %}
  <a class="text-link{% if light %} text-link--light{% endif %}" href="{{ link.url }}">{{ link.label }} <span aria-hidden="true">→</span></a>
{% endmacro %}

{% macro sectionHeading(section) %}
  <div class="section-heading">
    <div>
      <p class="kicker">{{ section.kicker }}</p>
      <h2>{{ section.heading }}</h2>
    </div>
    {{ textLink(section.link) }}
  </div>
{% endmacro %}

<section class="hero">
  <div class="hero__copy">
    <p class="hero__place">{{ index.hero.place }}</p>
    <h1>{{ index.hero.heading }}</h1>
    <p class="hero__lede">{{ index.hero.lede }}</p>
    <div class="hero__actions">
      {% for action in index.hero.actions %}
        {% if action.variant == "button" %}
          <a class="button button--light" href="{{ action.url }}">{{ action.label }}</a>
        {% else %}
          {{ textLink(action, true) }}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% set portrait = index.hero.portrait %}
  <figure class="hero__portrait">
    <img src="{{ portrait.src }}" srcset="{{ portrait.srcset }}" sizes="{{ portrait.sizes }}" alt="{{ portrait.alt }}" width="{{ portrait.width }}" height="{{ portrait.height }}" fetchpriority="high">
    <figcaption>{{ portrait.caption }}</figcaption>
  </figure>
</section>

<section class="home-intro section-shell">
  <p class="kicker">{{ index.intro.kicker }}</p>
  <div class="home-intro__grid">
    <h2>{{ index.intro.heading }}</h2>
    <div>
      <p class="lede">{{ index.intro.lede }}</p>
      {% for paragraph in index.intro.body %}<p>{{ paragraph }}</p>{% endfor %}
      {{ textLink(index.intro.link) }}
    </div>
  </div>
</section>

<section class="work-band">
  <div class="section-shell">
    {{ sectionHeading(index.work) }}
    <div class="work-list">
      {% for item in index.work.items %}
        <a href="{{ item.url }}"><span>{{ item.label }}</span><strong>{{ item.title }}</strong><span aria-hidden="true">↗</span></a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="latest section-shell">
  {{ sectionHeading(index.latest) }}
  <div class="post-grid">
    {% for post in collections.posts | reverse %}{% if loop.index <= index.latest.limit %}
      <article class="h-entry">
        <p><time class="dt-published" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
        <h3><a class="p-name u-url" href="{{ post.url }}">{{ post.data.title | safe }}</a></h3>
        {% if post.data.tags %}<p class="tags">{% for tag in post.data.tags %}<span class="p-category">{{ tag }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
      </article>
    {% endif %}{% endfor %}
  </div>
</section>
