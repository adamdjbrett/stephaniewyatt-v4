---
layout: page.njk
title: Tags
kicker: Browse by subject
description: Topics across Stephanie Wyatt’s writing archive.
permalink: /tags/
---
{% set tagNames = ["ministry", "teaching", "scholarship", "sermons", "presentations", "pastor", "note", "books"] %}
{% for tag in tagNames %}
  {% set tagged = collections.posts | selectattr("data.tags", "defined") | list %}
  <section class="tag-group">
    <h2>{{ tag | capitalize }}</h2>
    <ul>{% for post in collections.posts | reverse %}{% if post.data.tags and tag in post.data.tags %}<li><a href="{{ post.url }}">{{ post.data.title | safe }}</a></li>{% endif %}{% endfor %}</ul>
  </section>
{% endfor %}
